{
  "manifest_version": 3,
  "name": "Mouse Tab History",
  "version": "1.0.0",
  "description": "Go back and forward through the tabs you viewed, with your mouse side buttons or the keyboard.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Mouse Tab History settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shortcuts.js",
        "content.js"
      ],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    }
  ],
  "commands": {
    "previous": {
      "suggested_key": {
        "default": "Alt+Shift+Left",
        "mac": "MacCtrl+Shift+Left"
      },
      "description": "Go to the previously viewed tab"
    },
    "next": {
      "suggested_key": {
        "default": "Alt+Shift+Right",
        "mac": "MacCtrl+Shift+Right"
      },
      "description": "Go to the next viewed tab"
    }
  }
}
